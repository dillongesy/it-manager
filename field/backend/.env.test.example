# Copy to .env.test to enable integration tests (npm run test:integration).
# Point at a THROWAWAY test database - the tests create and delete rows.
#
# One-time setup on the Field database server (localhost):
#   sudo -u postgres psql -c "CREATE DATABASE field_test OWNER field;"
# Then migrate it from Windows:
#   DB_NAME=field_test npm run migrate
#   (PowerShell: $env:DB_NAME='field_test'; npm run migrate; Remove-Item Env:DB_NAME)
#
# Never point this at field (the real DB) - tests write and delete data.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=field_test
DB_USER=field
DB_PASSWORD=your_field_password
