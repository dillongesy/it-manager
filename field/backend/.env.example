# LOCAL DEVELOPMENT ONLY (npm run dev). Docker deployments generate all secrets
# in the `init` container and do not use this file.

# Database - separate from Portal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=field
DB_USER=field
DB_PASSWORD=change_this_strong_password

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_64_byte_hex
REFRESH_TOKEN_SECRET=replace_with_different_64_byte_hex
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Encrypts two-factor authentication secrets at rest (64 hex characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_byte_hex

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# Shared-inventory bridge - the IT Portal presents this token to read/use stock.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match FIELD_API_TOKEN in the Portal's .env. Leave blank to disable the bridge.
SERVICE_TOKEN=replace_with_32_byte_hex
