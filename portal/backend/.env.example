# LOCAL DEVELOPMENT ONLY (npm run dev). Docker deployments don't use this file:
# there, every secret is generated by the `init` container and integrations are
# configured in the app under Admin → Integrations.
#
# Quick start: node scripts/gen-env.js  (writes .env with fresh secrets)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal
DB_USER=portal
DB_PASSWORD=change_this_strong_password

ACCESS_TOKEN_SECRET=replace_with_64_byte_hex
REFRESH_TOKEN_SECRET=replace_with_different_64_byte_hex
# 32 bytes (64 hex chars). Decrypts every stored credential — never lose it.
ENCRYPTION_KEY=replace_with_32_byte_hex

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Field App bridge (the Field API running locally). Leave blank to disable
# Inventory and Field Jobs.
FIELD_API_URL=http://localhost:3001
FIELD_API_TOKEN=replace_with_field_service_token

# Integration credentials are set in Admin → Integrations. Legacy variables such
# as CONNECTWISE_CLIENT_ID=… are still read ONCE on start-up to seed an
# integration that has never been saved (handy when upgrading an old install).
