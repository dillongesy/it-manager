{
  "name": "it-manager-portal-backend",
  "version": "1.0.0",
  "description": "IT Manager Portal API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --import ./test/setup-env.js --test \"test/unit/**/*.test.js\"",
    "test:unit": "node --import ./test/setup-env.js --test \"test/unit/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "$uuid"
    },
    "brace-expansion": "^5.0.12",
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
