# Settings for docker-compose.yml. install.sh and the setup wizard write .env for you;
# every value has a working default. There are no secrets here: every secret is generated
# inside Docker on first start (the `init` service).

# Names and IP addresses for the Portal's certificate, comma-separated: the server's IP and
# any local DNS names for it (for example portal.office.lan). localhost is always included.
PORTAL_HOSTNAMES=192.168.1.10

# Who may open the Portal (space-separated CIDRs): the office network, plus any VPN.
# Default: all private and loopback ranges. The reverse proxy's network is always refused.
PORTAL_ALLOWED_SOURCES="192.168.1.0/24"

# Host ports. The Portal is on 443 (office network only). Nginx Proxy Manager serves the
# Field App on 4443; the router maps the public port 443 to it. The proxy admin page is on
# 81 (office network only), and port 80 answers HTTP certificate validation.
# PORTAL_PORT=443
# PROXY_HTTPS_PORT=4443
# PROXY_ADMIN_PORT=81

# Internal Docker subnets: <prefix>.0.0/24 ... <prefix>.8.0/24. Chosen in the setup wizard.
NET_PREFIX=172.29

# Image source and version. Default: ghcr.io/dillongesy/it-manager, latest.
# IMAGE_REGISTRY=ghcr.io/dillongesy/it-manager
# IMAGE_TAG=latest

# Prefix for auto-generated inventory SKUs (INV-00001).
# SKU_PREFIX=INV
