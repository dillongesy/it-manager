# Optional settings for docker-compose.yml. Every value has a working default, so this
# file is not required; install.sh writes .env for you. There are no secrets here:
# every secret is generated inside Docker on first start (the `init` service).

# Names and IP addresses staff use to open the Portal (https://<name>:8443), comma-
# separated. The Portal's HTTPS certificate covers these plus localhost.
PORTAL_HOSTNAMES=192.168.1.10,portal.lan

# Host ports. 80 and 443 belong to Nginx Proxy Manager (forward only these from the
# router); the Portal and the proxy admin UI should be reachable from the LAN only.
# PORTAL_PORT=8443
# PROXY_ADMIN_PORT=81

# Who may open the Portal (space-separated CIDRs). Default: private and loopback
# ranges. The reverse proxy's network is always refused.
# PORTAL_ALLOWED_SOURCES=192.168.1.0/24 10.8.0.0/24

# Internal Docker subnets: <prefix>.0.0/24 ... <prefix>.8.0/24. Change only if it
# collides with a network you already use (install.sh checks this for you).
NET_PREFIX=172.29

# Image source and version. Default: ghcr.io/dillongesy/it-manager, latest.
# IMAGE_REGISTRY=ghcr.io/dillongesy/it-manager
# IMAGE_TAG=latest

# Prefix for auto-generated inventory SKUs (INV-00001).
# SKU_PREFIX=INV
