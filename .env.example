# Non-secret deployment settings. install.sh writes .env for you — copy this by
# hand only if you skip the installer. There are NO passwords here: every secret
# is generated inside Docker on first boot (see the `init` service).

# Where the images come from (GitHub Container Registry, built by .github/workflows).
IMAGE_REGISTRY=ghcr.io/your-org/it-manager
IMAGE_TAG=latest

# ── Portal (LAN-only by default) ──────────────────────────────────────────────
# Site address(es) Caddy answers on. LAN mode: the server's IP and/or local DNS
# name(s). Domain mode: a real hostname pointed at this server.
PORTAL_SITE=https://192.168.1.10
PORTAL_ORIGIN=https://192.168.1.10
# "tls internal" = Caddy's own CA (self-signed; trust its root once per PC with
# scripts/export-ca.sh). "tls you@example.com" = automatic Let's Encrypt.
PORTAL_TLS=tls internal
# Who may open the Portal at all. private_ranges = LAN/VPN only (recommended).
PORTAL_ALLOWED_RANGES=private_ranges

# ── Field App (phones) ────────────────────────────────────────────────────────
FIELD_PORT=8443
FIELD_SITE=https://192.168.1.10:8443
FIELD_ORIGIN=https://192.168.1.10:8443
FIELD_TLS=tls internal
# private_ranges = LAN only for now. To put the Field App on the internet later,
# set 0.0.0.0/0 (and a real domain + Let's Encrypt) — see docs/FIELD-PUBLIC-HOSTING.md.
FIELD_ALLOWED_RANGES=private_ranges

# Prefix for auto-generated inventory SKUs (INV-00001).
SKU_PREFIX=INV

# Internal Docker subnets: <prefix>.0.0/24 … <prefix>.8.0/24. Change only if it
# collides with a network you already use.
NET_PREFIX=172.29
