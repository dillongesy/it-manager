# Edge — the only container with published ports. Terminates TLS and forwards to
# the two web containers over separate internal networks (portal_edge / field_edge).
# It cannot reach either API or database.
#
# Configured from .env (written by install.sh), substituted before parsing:
#   PORTAL_SITE            e.g. "https://192.168.5.10, https://portal.lan" or "portal.example.com"
#   PORTAL_TLS             "tls internal" (self-signed, LAN) or "tls you@example.com" (Let's Encrypt)
#   PORTAL_ALLOWED_RANGES  who may open the Portal at all (default: private_ranges = LAN only)
#   FIELD_SITE / FIELD_TLS / FIELD_ALLOWED_RANGES   — the same for the Field App
{
	# No admin API. Caddy trusts no upstream proxy by default, so a client-supplied
	# X-Forwarded-For is discarded and replaced with the real peer address.
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

{$PORTAL_SITE} {
	{$PORTAL_TLS}
	@outside not remote_ip {$PORTAL_ALLOWED_RANGES}
	abort @outside
	import security_headers
	encode zstd gzip
	reverse_proxy portal-web:8080
}

{$FIELD_SITE} {
	{$FIELD_TLS}
	@outside not remote_ip {$FIELD_ALLOWED_RANGES}
	abort @outside
	# The Portal↔Field bridge is internal-only — never served at the edge.
	@bridge path /api/service /api/service/*
	respond @bridge 404
	import security_headers
	encode zstd gzip
	reverse_proxy field-web:8080
}
